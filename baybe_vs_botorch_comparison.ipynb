   "source": [
    "## Comparison and Analysis\n",
    "\n",
    "Now let's compare the results from both implementations and analyze how constraint handling works."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "comparison_code"
   },
   "outputs": [],
   "source": [
    "def compare_implementations(baybe_results, botorch_results):\n",
    "    \"\"\"Compare the results from both implementations.\"\"\"\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"Implementation Comparison\")\n",
